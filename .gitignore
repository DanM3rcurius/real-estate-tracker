# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- hofradar ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# The database itself is never committed - it is the owner's search history,
# and this repository is public. data/ keeps its structure so the layout is
# visible, and data/seed/ carries the synthetic dataset the public Pages
# snapshot is built from. Git cannot re-include a path inside an excluded
# *directory*, so each of these ignores the contents and re-admits the marker.
data/*.sqlite3
data/*.sqlite3-*
data/secret_key
data/raw/*
!data/raw/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/images/*
!data/images/.gitkeep
data/exports/*
!data/exports/.gitkeep
# The static export. Built by .github/workflows/pages.yml, never committed.
site/

reports/weekly/*.md
reports/weekly/*.html
!.gitkeep
