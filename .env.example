# Copy to .env. Everything here is optional - the app boots without any of it.

# ---- ACCESS ----------------------------------------------------------------
# Set ONE of these to switch the password gate on. With neither set the UI is
# open to anyone who can reach it, which is fine on localhost and not fine on a
# public URL. Prefer the hash: `hofradar hash-password` prints one, and it can
# sit in a compose file or a Fly secret without being the password itself.
HOFRADAR_PASSWORD_HASH=
# HOFRADAR_PASSWORD=

# HMAC key for the session cookie. Generated and persisted next to the database
# if unset, which is what you want for a single instance. Set it explicitly if
# you run more than one, or the instances will reject each other's cookies.
# HOFRADAR_SECRET_KEY=

# Set to 1 if the app is behind HTTPS but does not see X-Forwarded-Proto.
# HOFRADAR_FORCE_SECURE_COOKIES=1

# Enables the LLM deep-review stage. Without it the deterministic pipeline still
# runs end to end and the review stage is skipped.
ANTHROPIC_API_KEY=
HOFRADAR_LLM_MODEL=claude-sonnet-5

# Where the SQLite file lives (ignored if HOFRADAR_DATABASE_URL is set).
HOFRADAR_DATA_DIR=data
# HOFRADAR_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hofradar

# Geo providers. Defaults are the free public instances - be polite with them,
# or point these at your own.
# HOFRADAR_NOMINATIM_URL=https://nominatim.openstreetmap.org
# HOFRADAR_OSRM_URL=https://router.project-osrm.org
# Resolve places from the bundled gazetteer only; never call out. Useful offline.
# HOFRADAR_OFFLINE=1

# Optional discovery search backend for the web_search source.
# HOFRADAR_SEARCH_ENDPOINT=
# HOFRADAR_SEARCH_API_KEY=

# Weekly pipeline schedule (cron, local time).
HOFRADAR_SCHEDULE_CRON=0 6 * * 1
