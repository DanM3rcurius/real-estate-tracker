# Seed configuration for deploy/raspberrypi/bootstrap.sh.
#
# Copy to /opt/hofradar/hofradar.env, edit, then run the bootstrap. It is
# sourced by bash, so quote anything containing spaces - a bare
# `HOFRADAR_SCHEDULE_CRON=0 6 * * 1` makes bash try to run the command `6`
# and aborts the bootstrap before Docker is installed.
#
# Every value below has a working default. The defaults give you a LAN-only
# box on http://hofradar.local:8000 with the password gate on and a password
# generated on first run - which is the shape a Raspberry Pi at home should
# have. Nothing here needs a domain, a port forward or a certificate.

# ---- runtime ---------------------------------------------------------------
# docker  - same shape as the Hetzner VPS: one compose project, one systemd
#           unit, `hofradar-update` rebuilds it. Costs ~15-25 min for the first
#           ARM image build and ~250 MB more RAM. Wants 4 GB or more.
# native  - a virtualenv and two systemd units, no Docker at all. Installs in
#           2-4 minutes, survives on a 2 GB Pi, and `hofradar` is on your PATH.
HOFRADAR_RUNTIME=docker

HOFRADAR_REPO=https://github.com/DanM3rcurius/real-estate-tracker.git
HOFRADAR_BRANCH=trunk

# ---- how it is reachable ---------------------------------------------------
# Default: listen on every interface so the LAN can reach it, gate on. Set
# 127.0.0.1 to make it local-only (then reach it over an SSH tunnel or
# Tailscale). Ignored when HOFRADAR_PROXY=caddy, which binds loopback itself.
HOFRADAR_BIND_ADDR=0.0.0.0
HOFRADAR_PORT=8000

# none  - plain HTTP, LAN or Tailscale only. The right answer at home.
# caddy - a TLS terminator on :80/:443. Only useful if this Pi is actually
#         reachable from the internet by name; see the README on DS-Lite,
#         which is why that is often not the case on a German home line.
HOFRADAR_PROXY=none
HOFRADAR_DOMAIN=
ACME_EMAIL=
# Only for a *.duckdns.org name: keeps the record pointed at your current
# home IP, which changes when the router reconnects.
DUCKDNS_TOKEN=

# Install Tailscale. This is the recommended way to reach the Pi from outside
# the house: no open ports, no certificate, no dynamic-DNS updater.
HOFRADAR_TAILSCALE=0
# Optional pre-authorised key (tailscale.com > Settings > Keys). Without it the
# bootstrap prints the `tailscale up` command for you to run interactively.
TAILSCALE_AUTHKEY=

# ---- storage ---------------------------------------------------------------
# WHERE THE DATABASE LIVES. The database remembering what it has seen is the
# product, and an SD card is the least durable part of a Pi. Point this at a
# directory on a USB SSD if you have one, e.g. /mnt/ssd/hofradar.
# Empty means: a Docker named volume (docker runtime) or /var/lib/hofradar
# (native runtime) - both on whatever disk / is on.
HOFRADAR_DATA_MOUNT=

HOFRADAR_BACKUP_DIR=/var/backups/hofradar
# Optional. Anything rsync accepts: user@nas:/volume1/backup/hofradar/ or a
# mounted path. A backup that only exists on the Pi does not survive the Pi
# being stolen, dropped or set on fire by its own power supply.
HOFRADAR_BACKUP_RSYNC_TARGET=

# ---- the app ---------------------------------------------------------------
# Leave empty to have a password generated and left in
# /home/hofradar/INITIAL_PASSWORD.txt. `hofradar hash-password` prints one.
HOFRADAR_PASSWORD_HASH=
# Optional. Without it the deterministic pipeline still runs end to end.
ANTHROPIC_API_KEY=
HOFRADAR_LLM_MODEL=claude-sonnet-5
# Optional. TypeSafe System One (Jev) triage of rentals and flats during the crawl.
TYPESAFE_API_KEY=
HOFRADAR_JEV_MODEL=jev-latest
HOFRADAR_SCHEDULE_CRON="0 6 * * 1"
