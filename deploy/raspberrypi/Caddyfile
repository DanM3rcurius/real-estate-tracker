# Optional TLS terminator, started only with HOFRADAR_PROXY=caddy.
#
# You probably do not need this. A Pi at home is reached over the LAN or over
# Tailscale, and neither wants a public certificate. Caddy earns its place in
# exactly one case: the Pi is reachable from the internet by name, on a line
# that still has a routable IPv4 address. See the README - German DS-Lite
# connections do not, and no amount of port forwarding changes that.
#
# What it does when it does run: gets a Let's Encrypt certificate on its own,
# and sets X-Forwarded-Proto - which is how hofradar.web.auth decides to mark
# the session cookie Secure. Without a proxy that sets it, force it with
# HOFRADAR_FORCE_SECURE_COOKIES=1.
#
# With HOFRADAR_DOMAIN unset this falls back to plain HTTP on :80, which is
# only sensible on the LAN.

{
	email {$ACME_EMAIL:admin@example.com}
}

{$HOFRADAR_DOMAIN::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The app's own health endpoint tells an anonymous caller only
	# {"status":"ok"}, so it is safe to let Caddy poll it (invariant 8).
	reverse_proxy hofradar:8000 {
		health_uri /healthz
		health_interval 30s
		health_timeout 5s
	}
}
